# Local native defaults. No hosted credentials or paid AI services.
PORT=3200
HOST=127.0.0.1
DATABASE_URL=postgres://postgres:local-capstone-only@127.0.0.1:5434/image_relevance
DATA_DIR=./data
OLLAMA_URL=http://127.0.0.1:11435
VISION_MODEL=qwen3-vl:2b
EMBEDDING_MODEL=all-minilm
MODEL_TIMEOUT_MS=300000
WORKER_ENABLED=true
WORKER_POLL_MS=1000
JOB_MAX_ATTEMPTS=3
JOB_RETRY_MS=2000
DAILY_CALL_LIMIT=250
DAILY_USD_LIMIT=0
# Omit threshold overrides to use evals/thresholds.json after calibration.
# SIMILARITY_THRESHOLD=0.4
# CONFIDENCE_THRESHOLD=0.75

# Vercel build only; use a real external HTTPS backend origin.
# BACKEND_ORIGIN=https://your-backend-host.example
